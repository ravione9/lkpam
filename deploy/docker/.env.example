# Compose settings (ports, URLs). Loaded for ${VAR} substitution in docker-compose.yml.
# Do NOT put secrets here — use secrets.env instead (see secrets.env.example).
#
#   cp .env.example .env

PAM_HTTP_PORT=8080
PAM_SSH_PORT=2222
PAM_TACACS_PORT=49
PAM_PORTAL_URL=http://localhost:8080
PAM_ADMIN_USER=admin
