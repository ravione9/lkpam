# Compose settings (host-side only). Loaded by Docker Compose for ${VAR}
# substitution in docker-compose.yml — these values are NOT passed into
# containers. Put runtime configuration and secrets in secrets.env instead.
#
#   cp .env.example .env

# Host-side ports
PAM_HTTP_PORT=8080
PAM_SSH_PORT=2222
PAM_TACACS_PORT=49
PAM_RADIUS_AUTH_PORT=1812
PAM_RADIUS_ACCT_PORT=1813

# Public URL of the portal (used by the gateway and embedded in browser
# viewer links). Set this to the address users actually reach, e.g.
#   http://192.168.24.253:8080
#   https://pam.corp.local
PAM_PORTAL_URL=http://localhost:8080

# guacd address for rdp-proxy (default host.docker.internal:4822 when guacd uses host network)
# PAM_GUACD_ADDR=host.docker.internal:4822

# Address guacd dials for browser SSH (guacd uses host network on Linux — use loopback)
# PAM_SSH_PROXY_DIAL_ADDR=127.0.0.1:2222
