# Copy to .env and change before production use:
#   cp .env.example .env
#
# IMPORTANT: If a password/secret contains a dollar sign ($), escape it as $$ in this file.
# Example:  PAM_TACACS_SECRET=ab$$cd   (actual secret is ab$cd)
# Without escaping, Compose warns "variable is not set" and corrupts the secret.

# Required — use a long random string (openssl rand -hex 32)
PAM_JWT_SECRET=dev-change-me-use-openssl-rand

# Required for stable vault encryption across restarts (openssl rand -base64 32)
# Base64 often contains + and / but rarely $; if yours does, use $$ for each $.
PAM_MASTER_KEY=

# TACACS+ shared secret — must match device config (server-private … key …)
# Avoid $ in secrets, or escape as $$ (see note above).
PAM_TACACS_SECRET=change-me

# Host port for TACACS+ (maps to container port 1049; default 49 for Cisco devices)
PAM_TACACS_PORT=49

# Bootstrap admin (first run only, when DB is empty)
PAM_ADMIN_USER=admin
PAM_ADMIN_PASS=admin
