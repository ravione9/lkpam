# Runtime configuration + secrets for PAM containers. Injected via env_file by
# docker-compose.yml. Compose does NOT do $-expansion inside this file, so $
# characters in passwords are safe (unlike deploy/docker/.env).
#
#   cp secrets.env.example secrets.env
#   chmod 600 secrets.env
#
# Generate strong values:
#   openssl rand -hex 32      # for PAM_JWT_SECRET / PAM_TACACS_SECRET
#   openssl rand -base64 32   # for PAM_MASTER_KEY

# --- Cryptographic secrets ---
# HS256 signing secret for portal JWTs.
PAM_JWT_SECRET=dev-change-me-use-openssl-rand

# Base64 32-byte vault encryption key.
# Leave empty to auto-create one at /data/.master_key on first boot
# (shared across all containers via the pam-data volume).
PAM_MASTER_KEY=

# Shared secret network devices use to authenticate to the PAM TACACS+ server.
# Must match `aaa group server tacacs+ ... key <secret>` on the device.
PAM_TACACS_SECRET=change-me

# Global fallback RADIUS shared secret. Per-device secrets in the radius_clients
# table override this. Must match `radius-server host ... key <secret>` on HP/
# Aruba/MikroTik/PaloAlto/Juniper/F5/Huawei devices that point at PAM.
PAM_RADIUS_SECRET=change-me

# --- Bootstrap admin (used the first time the DB is empty) ---
PAM_ADMIN_USER=admin
PAM_ADMIN_PASS=admin
