# Secrets for PAM containers — copied into each service via env_file.
# Compose does NOT parse $ inside this file (unlike deploy/docker/.env).
#
#   cp secrets.env.example secrets.env
#   chmod 600 secrets.env
#
# Generate strong values:
#   openssl rand -hex 32

PAM_JWT_SECRET=dev-change-me-use-openssl-rand

# Base64 32-byte vault key (openssl rand -base64 32). Leave empty to auto-create on first boot.
PAM_MASTER_KEY=

# TACACS+ shared secret — must match network device config (server-private … key …)
PAM_TACACS_SECRET=change-me

# Bootstrap admin password (first run only, when DB is empty)
PAM_ADMIN_PASS=admin
